# Gere uma chave longa e aleatória antes de usar fora do desenvolvimento.
TABELEAO_SECRET_KEY=troque-por-uma-chave-secreta-longa
POSTGRES_DB=cartorio_ai
POSTGRES_USER=cartorio
POSTGRES_PASSWORD=cartorio_dev
# Em Windows com política que bloqueie a DLL nativa, use postgresql+pg8000.
DATABASE_URL=postgresql+psycopg://cartorio:cartorio_dev@localhost:5432/cartorio_ai
# Tempo máximo, em segundos, para estabelecer uma conexão com o PostgreSQL.
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800
FRONTEND_ORIGINS=http://localhost:3000,http://tabeleao.local:3000

# Deixe NEXT_PUBLIC_API_URL vazio para usar o proxy local do Next.js.
NEXT_PUBLIC_API_URL=
BACKEND_INTERNAL_URL=http://localhost:8000

# Autenticação local
MAX_LOGIN_ATTEMPTS=5
# Segundo fator TOTP; mantenha true fora do período temporário de testes.
MFA_ENABLED=true
# A sessão é renovada a cada atividade autenticada; 480 minutos = 8 horas.
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_NAME=tabeleao_access
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# RAG e Ollama
RAG_CONFIDENCE_THRESHOLD=0.28
RAG_QUERY_EMBEDDING_CACHE_SIZE=256
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LOCAL_ONLY=true
OLLAMA_EMBED_MODEL=nomic-embed-text-v2-moe
OLLAMA_EMBED_NUM_GPU=0
OLLAMA_GENERATION_MODEL=qwen3:8b
# Modelo mais leve e independente para respostas da Consulta. O modelo de 8B continua reservado para análises profundas.
OLLAMA_CONSULTA_MODEL=qwen3:8b
OLLAMA_VISION_MODEL=qwen3-vl:8b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CONSULTA_MAX_TOKENS=700
OLLAMA_CONSULTA_CONTEXT_TOKENS=8192
A2_FACT_BLOCK_CHAR_LIMIT=8000
A2_FACT_MAX_BLOCKS=25
MINUTA_MODEL_CONTEXT_LIMIT=18000
MINUTA_TOTAL_CONTEXT_LIMIT=24000

# OCR local (executáveis no PATH ou caminhos absolutos; dados nunca enviados à rede)
OCR_ENABLED=true
OCR_PDFTOPPM_COMMAND=pdftoppm
OCR_TESSERACT_COMMAND=tesseract
OCR_LANGUAGES=por+eng
OCR_MAX_PAGES_PER_DOCUMENT=300
OCR_DOCUMENT_TIMEOUT_SECONDS=1800
OCR_PAGE_TIMEOUT_SECONDS=90
OCR_RENDER_DPI=300

# Ata Notarial temporária (processamento local)
ATA_MAX_UPLOAD_BYTES=2147483648
ATA_MAX_EXTRACTED_BYTES=4294967296
ATA_MAX_ARCHIVE_ENTRIES=20000
ATA_MAX_COMPRESSION_RATIO=200
WHISPER_COMMAND=whisper
# Deve apontar para um modelo Whisper já existente no disco; não há download automático.
WHISPER_MODEL_PATH=
FFMPEG_COMMAND=ffmpeg
FFPROBE_COMMAND=ffprobe
RAR_TOOL_COMMAND=7z
