# Gere uma chave longa e aleatória antes de usar fora do desenvolvimento.
TABELEAO_SECRET_KEY=troque-por-uma-chave-secreta-longa
POSTGRES_DB=cartorio_ai
POSTGRES_USER=cartorio
POSTGRES_PASSWORD=cartorio_dev
# Em Windows com política que bloqueie a DLL nativa, use postgresql+pg8000.
DATABASE_URL=postgresql+psycopg://cartorio:cartorio_dev@127.0.0.1:5432/cartorio_ai
# Tempo máximo, em segundos, para estabelecer uma conexão com o PostgreSQL.
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800
FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://tabeleao.local:3000

# Deixe NEXT_PUBLIC_API_URL vazio para usar o proxy local do Next.js.
NEXT_PUBLIC_API_URL=
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Piloto da Consulta: mantém Análise, Minuta e Ata fora da interface e da API.
CONSULTA_ONLY_MODE=true

# Autenticação local
MAX_LOGIN_ATTEMPTS=5
# Segundo fator TOTP; mantenha true fora do período temporário de testes.
MFA_ENABLED=true
# A sessão é renovada a cada atividade autenticada; 480 minutos = 8 horas.
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_NAME=tabeleao_access
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Gemini File Search para a Consulta.
# Configure a chave e confirme o nível gratuito somente em um projeto sem
# faturamento ativo. A aplicação não consegue verificar o faturamento; se a cota
# acabar, a Consulta informa indisponibilidade e não troca para outro provedor.
# Documentos de consulta aprovados são sincronizados automaticamente.
# O plano gratuito pode usar os dados para melhoria/revisão humana. Não envie
# dados pessoais, confidenciais ou sensíveis.
EXTERNAL_AI_ENABLED=false
EXTERNAL_AI_FREE_TIER_CONFIRMED=false
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2
EXTERNAL_AI_REQUEST_TIMEOUT_SECONDS=90
EXTERNAL_AI_MAX_ATTEMPTS=5
EXTERNAL_AI_WORKER_INTERVAL_SECONDS=5
EXTERNAL_AI_MAX_SOURCE_BYTES=5242880

# OCR executado localmente; o texto aprovado pode ser sincronizado com o Gemini.
OCR_ENABLED=true
OCR_PDFTOPPM_COMMAND=pdftoppm
OCR_TESSERACT_COMMAND=tesseract
OCR_LANGUAGES=por+eng
OCR_MAX_PAGES_PER_DOCUMENT=300
OCR_DOCUMENT_TIMEOUT_SECONDS=1800
OCR_PAGE_TIMEOUT_SECONDS=90
OCR_RENDER_DPI=300
